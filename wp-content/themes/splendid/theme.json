{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": { "contentSize": "1180px", "wideSize": "1400px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "brand", "color": "#18743c", "name": "Splendid green" },
				{ "slug": "forest", "color": "#123c2b", "name": "Deep green" },
				{ "slug": "footer", "color": "#0b281c", "name": "Footer green" },
				{ "slug": "white", "color": "#ffffff", "name": "White" },
				{ "slug": "soft", "color": "#f3f5f4", "name": "Subtle background" },
				{ "slug": "line", "color": "#dce2e3", "name": "Rule and card border" },
				{ "slug": "body", "color": "#5b686d", "name": "Body text" },
				{ "slug": "light-green", "color": "#c7ebbd", "name": "Light green on dark" }
			]
		},
		"typography": {
			"customFontSize": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "SplendidSans, Arial, sans-serif",
					"slug": "sans",
					"name": "Splendid Sans",
					"fontFace": [
						{
							"fontFamily": "SplendidSans",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/sans.ttf" ]
						}
					]
				},
				{
					"fontFamily": "SplendidSerif, Georgia, serif",
					"slug": "serif",
					"name": "Splendid Serif",
					"fontFace": [
						{
							"fontFamily": "SplendidSerif",
							"fontWeight": "400 700",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/serif.ttf" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "14px", "name": "Label" },
				{ "slug": "medium", "size": "16px", "name": "Body" },
				{ "slug": "large", "size": "1.5rem", "name": "Heading 3" },
				{ "slug": "x-large", "size": "clamp(2.3rem, 3.7vw, 4rem)", "name": "Heading 2" },
				{ "slug": "xx-large", "size": "clamp(4rem, 6.4vw, 7rem)", "name": "Hero" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "10", "size": "25px", "name": "Grid gap" },
				{ "slug": "20", "size": "58px", "name": "Section (mobile)" },
				{ "slug": "30", "size": "95px", "name": "Section" }
			]
		},
		"border": { "radius": true, "color": true, "style": true, "width": true }
	},
	"styles": {
		"color": { "background": "#ffffff", "text": "#123c2b" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "16px",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": { "color": { "text": "#18743c" } },
			"h1": { "typography": { "fontWeight": "500", "letterSpacing": "-0.045em", "lineHeight": "1.12" } },
			"h2": { "typography": { "fontWeight": "500", "letterSpacing": "-0.045em", "lineHeight": "1.12" } },
			"h3": { "typography": { "fontWeight": "500", "letterSpacing": "-0.025em", "lineHeight": "1.12" } }
		}
	}
}
